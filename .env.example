# ============================================================
# TG Shop — пример переменных окружения
# Скопируйте в .env и заполните значениями.
# Все переменные можно оставить пустыми, если они помечены (необязательно).
# ============================================================

# ==========================
# Telegram
# ==========================

# Токен основного бота (от @BotFather) — обязательный.
BOT_TOKEN=your_bot_token_here

# Токен платформенного бота-регистратора для онбординга новых магазинов (необязательно).
# PLATFORM_BOT_TOKEN=

# ID чата/пользователя для уведомлений о новых заказах (необязательно).
# Узнать chat_id: напишите @userinfobot.
# MANAGER_CHAT_ID=

# Telegram ID администраторов магазина через запятую (необязательно).
# Только этим ID доступна панель управления /admin.
# ADMIN_IDS=

# Telegram ID супер-админов SaaS-платформы через запятую (необязательно).
# Супер-админ может создавать/редактировать/удалять магазины.
# SUPER_ADMIN_IDS=

# Прокси для доступа к Telegram API, если api.telegram.org заблокирован (необязательно).
# Форматы: http://host:port, socks5://host:port
# BOT_PROXY=

# Максимальный возраст initData Telegram WebApp в секундах (по auth_date).
# Старые подписанные initData отклоняются (защита от replay). По умолчанию 300.
# ВАЖНО: Telegram генерирует initData один раз при открытии Mini App и не
# обновляет его внутри сессии. Если клиенты держат Mini App открытым дольше
# этого окна, запросы начнут получать 401 — при необходимости увеличьте
# значение (напр. 3600) или реализуйте серверные сессии.
# INIT_DATA_MAX_AGE=300

# Допустимое расхождение часов клиент/сервер в секундах при проверке auth_date
# (небольшие «будущие» значения в этом окне не отклоняются). По умолчанию 30.
# INIT_DATA_CLOCK_SKEW=30

# ==========================
# База данных
# ==========================

# Для локальной разработки (SQLite). В Docker переопределяется на PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./shop.db

# В Docker (docker-compose.yml) DATABASE_URL переопределяется на:
#   postgresql+asyncpg://tg_shop:$POSTGRES_PASSWORD@postgres:5432/tg_shop
POSTGRES_PASSWORD=changeme

# ==========================
# Приложение
# ==========================

DEBUG=False
SHOP_NAME=Магазин по умолчанию

# Домен для Caddy (без протокола, напр. example.com).
DOMAIN=svechevarov-family.ru

# Базовый URL приложения (с протоколом) — для WebApp, вебхуков и admin-панели.
APP_BASE_URL=https://svechevarov-family.ru

# URL админ-панели (отдельный поддомен, необязательно).
# ADMIN_PANEL_URL=https://admin.svechevarov-family.ru
# PLATFORM_ADMIN_URL=https://main-svoi.svechevarov-family.ru

# ==========================
# Admin Panel (JWT)
# ==========================

# Секрет для подписи JWT. Обязательный.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate-with-python-secrets-token-hex-32

# Разрешённые CORS-источники через запятую.
CORS_ORIGINS=http://localhost:3000

# Общий домен cookie для API и обеих панелей в production.
# COOKIE_DOMAIN=.example.com

# ==========================
# Шифрование (bot_token at rest)
# ==========================

# Ключ Fernet для шифрования токенов магазинов в БД. Обязательный.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-fernet-key

# ==========================
# ЮKassa (оплата подписок) — необязательно
# ==========================

# Получить в личном кабинете ЮKassa после модерации магазина.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# ==========================
# Tinkoff Acquiring (СБП QR) — необязательно
# ==========================

# TINKOFF_TERMINAL_KEY=
# TINKOFF_PASSWORD=

# ==========================
# Ручная оплата (без эквайринга) — необязательно
# ==========================

# PAYMENT_CARD_NUMBER=
# PAYMENT_RECIPIENT_NAME=

# ==========================
# Sentry (error tracking) — необязательно
# ==========================

# Получить: https://sentry.io/settings/<org>/projects/<project>/keys/
# SENTRY_DSN=https://xxxxx@oxxxxx.ingest.sentry.io/xxxxx

# ==========================
# AI-импорт из Telegram-канала — пилот
# ==========================

# Включает worker и realtime ingestion. Для безопасного пилота укажите один shop_id.
CHANNEL_IMPORT_ENABLED=False
# CHANNEL_IMPORT_PILOT_SHOP_ID=1
CHANNEL_PRODUCT_BUTTONS_ENABLED=False
# CHANNEL_PRODUCT_BUTTONS_PILOT_SHOP_ID=1

# Cloud AI получает только текст поста. Снимок модели закреплён для повторяемости.
# OPENAI_API_KEY=sk-...
OPENAI_CHANNEL_IMPORT_MODEL=gpt-5.4-mini-2026-03-17
CHANNEL_IMPORT_BUDGET_USD=2.0

# MTProto нужен только для импорта последних 50 исторических постов.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=
