(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-X-Powered-By
	}
}

(admin_security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://{$DOMAIN}; worker-src 'self' blob:; frame-src 'none'; upgrade-insecure-requests"
		Cross-Origin-Opener-Policy "same-origin"
		Referrer-Policy "no-referrer"
	}
}

(miniapp_security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors https://web.telegram.org https://*.telegram.org; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; upgrade-insecure-requests"
		Referrer-Policy "no-referrer"
	}
}

{$DOMAIN}, www.{$DOMAIN} {
	import security_headers
	import miniapp_security_headers
	encode zstd gzip
	reverse_proxy bot:8000
	handle_errors 502 503 504 {
		respond "Сервер недоступен. Попробуйте позже." 502
	}
}

admin.{$DOMAIN} {
	import security_headers
	import admin_security_headers
	reverse_proxy admin:3000
}

main-svoi.{$DOMAIN} {
	import security_headers
	import admin_security_headers
	reverse_proxy platform-admin:3000
}

svoi-kanal.ru {
	import security_headers
	encode zstd gzip
	root * /srv/landing
	header /img/* Cache-Control "public, max-age=604800"
	@legacy_index path /index.html
	redir @legacy_index / permanent
	file_server
}

www.svoi-kanal.ru {
	redir https://svoi-kanal.ru{uri} permanent
}

svoi.{$DOMAIN} {
	import security_headers
	header Referrer-Policy "strict-origin-when-cross-origin"
	@vless_websocket {
		path {$VLESS_WS_PATH}
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @vless_websocket {
		reverse_proxy xray:10000
	}
	handle {
		redir https://svoi-kanal.ru{uri} permanent
	}
}
